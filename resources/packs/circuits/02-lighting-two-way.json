  "faults": [],
  "theory": [
    "双控（两地控制）用两只单刀双掷开关串联组成。SA1 的公共端接相线，SA2 的公共端接灯，两只开关的 L1-L1、L2-L2 用两根联络线连接。",
    "两只开关的刀片位置相同时，回路接通，灯亮；任意一只开关动作后，回路断开，灯灭。因此在楼上楼下都能开灯、关灯。",
    "接线要点：公共端（L）不能接错，否则会出现「两开关都能开、都不能关」或灯不亮的现象。"
  ],
  "steps": [
    "合上 QF1。此时 SA1、SA2 都打在同一位置，灯亮。",
    "点击 SA1（或 SA2），观察灯熄灭；再次点击，灯又点亮。",
    "反复交替操作两只开关，体会「任一处均可控制」的效果。",
    "思考：若把 SA2 的公共端与 L1 接反，会出现什么现象？"
  ],
  "checkpoints": [
    "能画（接）出双控电路的两根联络线",
    "能说明公共端接错后的故障现象",
    "能举出双控电路的两个生活应用场景"
  ]
}
