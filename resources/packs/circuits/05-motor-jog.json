  ],
  "theory": [
    "点动控制是最简单的电力拖动环节：按下启动按钮，接触器线圈得电吸合，主触点闭合，电动机接通电源运转；松开按钮，线圈失电，主触点断开，电动机立即停转。",
    "控制电路中的停止按钮 SB1（常闭）用于停止，QF2 用于控制电路的电源控制与短路保护。",
    "点动与连续运行的区别在于：点动电路没有自锁触点，按钮松开后线圈立即失电，因此只能「按住才转」。"
  ],
  "steps": [
    "合上主电路断路器 QF1 与控制电路 QF2。",
    "按住 SB2 不松手，观察 KM1 线圈得电、主触点闭合、电动机启动。",
    "松开 SB2，观察接触器释放、电动机停转。",
    "按下 SB1（常闭停止按钮），体会其在控制电路中的串接作用。"
  ],
  "checkpoints": [
    "能说明接触器线圈与主触点的联动关系",
    "能解释点动电路为什么松开按钮就停转",
    "能区分主电路与控制电路的导线截面要求",
    "能对照原理图说出控制回路 0~4 号线的走向"
  ]
}
