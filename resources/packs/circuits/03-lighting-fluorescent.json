  "theory": [
    "荧光灯由灯管、镇流器和启辉器三部分组成。镇流器与灯管串联，启辉器与灯管并联（经镇流器接相线）。",
    "通电瞬间启辉器内双金属片受热闭合，灯丝通过电流预热；双金属片冷却断开时，镇流器产生很高的自感电动势，与电源电压叠加后击穿灯管气体，灯管点亮。",
    "灯管点亮后镇流器起限流作用，使灯管工作在额定电流下。若短接镇流器，灯管会因电流过大而烧毁。"
  ],
  "steps": [
    "合上 QF1，再合上开关 SA1，观察灯管点亮。",
    "观察镇流器与灯管的串联关系、启辉器与灯管的并联关系。",
    "断开 SA1，灯管熄灭，思考镇流器在启动瞬间的作用。",
    "讨论：为什么荧光灯不能像白炽灯那样直接接到 220V 电源上。"
  ],
  "checkpoints": [
    "能说明镇流器串联、启辉器并联的接线关系",
    "能解释镇流器产生高压点亮灯管的原理",
    "能说明镇流器的限流作用"
  ]
}
