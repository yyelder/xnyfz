  "theory": [
    "照明配电箱是建筑电气照明的电源分配中心，一般由总开关、漏电保护器、分支断路器组成，实现分级保护。",
    "总开关承担全屋通断与短路保护；漏电保护器检测相线与零线电流之差（剩余电流），当差值超过 30mA 时迅速跳闸，防止人身触电。",
    "各分支回路按负荷性质划分：照明回路、插座回路、空调回路等。支路断路器按导线截面与负荷电流选择，实现过载保护。",
    "注意：漏电保护器只保护单相接地（漏电）故障，相间短路仍需靠断路器的电磁脱扣来保护。"
  ],
  "steps": [
    "依次合上 QF0 总开关、QF1 漏电保护器。",
    "分别合上 QF2、QF3、QF4 三个支路开关，观察各支路负荷得电情况。",
    "在故障面板中选择「EL1 支路短路」，观察断路器保护动作与告警。",
    "复位后选择「XS1 插座短路」，比较漏电保护与短路保护的差异。"
  ],
  "checkpoints": [
    "能说出配电箱内各元件的名称与作用",
    "能解释漏电保护器 30mA 动作电流的含义",
    "能按负荷性质划分照明与插座支路"
  ]
}
