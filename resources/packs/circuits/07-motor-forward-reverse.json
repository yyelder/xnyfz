  "annotations": [
    { "text": "主电路：KM2 调换了两相相序（L1↔L2）", "x": 420, "y": 120, "size": 11, "color": "#1a5fb4" },
    { "text": "互锁：KM2 常闭触点串在正转回路，反之亦然", "x": 960, "y": 64, "size": 11, "color": "#d98218" },
    { "text": "两接触器同时吸合将造成相间短路", "x": 960, "y": 90, "size": 11, "color": "#d63a3a" }
  ],
  "faults": [
    { "id": "fr-trip", "name": "KH 热继电器过载", "type": "trip", "devices": ["FR1c"], "desc": "过载脱扣，两只接触器均失电" }
  ],
  "theory": [
    "三相异步电动机的转向由三相电源的相序决定。任意调换两相相序，电动机即反转。因此正反转控制用两只接触器：KM1 直接引入三相电源（正转），KM2 调换两相后引入（反转）。",
    "若两只接触器同时吸合，电源将经过它们形成相间短路，后果严重。因此必须在控制电路中设置联锁：把 KM2 的常闭辅助触点串入 KM1 线圈回路，把 KM1 的常闭辅助触点串入 KM2 线圈回路。",
    "这种依靠接触器自身触点实现的联锁称为「电气联锁」。若再采用复合按钮（按钮的常闭触点串入对方回路），则称为「双重联锁」，可进一步缩短换向时的断电时间。",
    "热继电器 KH 的常闭触点串在控制电路前端，任一方向运行时过载都能切断控制电路。"
  ],
  "steps": [
    "合上 QF1 与 QF2，按下 SB2，观察 KM1 吸合、电动机正转。",
    "不按停止按钮，直接按 SB3，观察是否被联锁阻止（KM1 未释放前 KM2 无法吸合）。",
    "按 SB1 停止后，再按 SB3，观察电动机反转（转向标识变化）。",
    "在故障面板触发 KH 过载，观察两个方向的控制电路同时失效。"
  ],
  "checkpoints": [
    "能说明调换两相相序改变转向的原理",
    "能正确接出接触器联锁回路",
    "能说明为什么必须设置联锁以及不联锁的后果",
    "能对照原理图说出控制回路 0~7 号线的走向"
  ]
}
